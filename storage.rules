rules_version = '2';

// Hardened Firebase Storage Security Rules for Creator Paisa
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Uploaded videos (Shorts max 50MB, Long videos max 250MB)
    match /videos/{uid}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(uid)
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 250 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
      allow delete: if isOwner(uid);
    }

    // Video thumbnails (max 10MB image)
    match /thumbnails/{uid}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(uid)
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isOwner(uid);
    }

    // Channel avatars, banners, and playlist covers (max 10MB image)
    match /images/{uid}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(uid)
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isOwner(uid);
    }

    // Default deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
